# URL del sitio público (carpinteriacillat_frontend_web) — usada por el panel de vista previa
# en vivo (widgets/landing-preview) para cargar su ruta /preview en un iframe. En local, levantar
# el intranet primero (queda en :3000) y luego el web (cae solo a :3001, Next.js detecta el
# puerto ocupado) — si preferís fijarlo, correlo con `next dev -p 3001` en ese proyecto.
NEXT_PUBLIC_WEB_PREVIEW_URL=http://localhost:3001

